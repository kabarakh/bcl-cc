{
  "name": "boulder-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "predeploy": "npm run build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "dexie": "^4.4.0",
    "flowbite": "^4.0.0",
    "flowbite-vue": "^0.2.0",
    "luxon": "^3.7.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/luxon": "^3.4.0",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.0",
    "fake-indexeddb": "^6.2.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.0",
    "prettier": "^3.9.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.0"
  }
}
